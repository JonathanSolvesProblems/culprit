# Copy to .env and fill in ONE provider. Culprit picks whichever key it finds.
#
# Culprit's reasoning is provider-agnostic, matching the convention DataHub's
# own Analytics Agent uses. Use whatever you already pay for.

# --- Option 1: OpenAI ---------------------------------------------------
# https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- Option 2: Anthropic ------------------------------------------------
# https://console.anthropic.com/settings/keys
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# --- Option 3: free and local, via Ollama -------------------------------
# Install from https://ollama.com, then: ollama pull qwen2.5:14b
# Costs nothing. Reasoning quality on this multi-step task is noticeably
# weaker than a frontier model; see the README for what to expect.
# LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# --- DataHub ------------------------------------------------------------
DATAHUB_GMS_URL=http://localhost:8080

# --- Optional: override cost estimation rates (USD per million tokens) ---
# CULPRIT_PRICE_IN=2.50
# CULPRIT_PRICE_OUT=10.00
